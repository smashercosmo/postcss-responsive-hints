{
  "name": "postcss-responsive-hints",
  "version": "2.0.6",
  "sideEffects": false,
  "type": "module",
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsdown",
    "dev": "tsdown --watch",
    "typecheck": "tsc --noEmit"
  },
  "devDependencies": {
    "shared": "*",
    "tsconfig": "*",
    "postcss": "catalog:dev",
    "tsdown": "catalog:dev"
  },
  "peerDependencies": {
    "postcss": ">=8"
  },
  "exports": {
    ".": "./src/index.ts",
    "./package.json": "./package.json"
  },
  "publishConfig": {
    "exports": {
      ".": "./dist/index.js",
      "./package.json": "./package.json"
    }
  }
}
