{
  "commit-msg": {
    "commands": {
      "executed-job": {
        "run": "echo \"Job was executed, as SOME_ENV_VARIABLE was equal to true\"",
        "only": [
          {
            "run": "node \"./check_if_env_variable_is_true.ts\" env_file_path=\"./.env.true\" env_variable_name=\"SOME_ENV_VARIABLE\""
          }
        ]
      },
      "skipped-job": {
        "run": "echo \"This job was skipped, as SOME_ENV_VARIABLE wasn't equal to true\"",
        "only": [
          {
            "run": "node \"./check_if_env_variable_is_true.ts\" env_file_path=\"./.env.false\" env_variable_name=\"SOME_ENV_VARIABLE\""
          }
        ]
      }
    }
  }
}
