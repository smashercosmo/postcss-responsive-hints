{
  "name": "root",
  "private": true,
  "description": "PostCSS plugin that makes it easier to write responsive styles",
  "keywords": [
    "postcss",
    "postcss-plugin"
  ],
  "homepage": "https://github.com/smashercosmo/postcss-responsive-hints#readme",
  "bugs": {
    "url": "https://github.com/smashercosmo/postcss-responsive-hints/issues"
  },
  "license": "MIT",
  "author": "Vladislav Shkodin <smashercosmo@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "test:ci": "turbo test --filter=!@root/github",
    "typecheck": "turbo typecheck && tsc --noEmit",
    "cleanup": "rm -rf node_modules .turbo pnpm-lock.json && pnpm -r exec rm -rf .turbo node_modules dist",
    "format": "oxfmt",
    "lint": "oxlint",
    "deps:update": "pnpm up -r --latest --interactive --include-github-actions",
    "deps:remove": "deps-remove",
    "deps:add": "deps-add",
    "actions:update": "actions-up"
  },
  "devDependencies": {
    "@commitlint/cli": "catalog:dev",
    "@commitlint/cz-commitlint": "catalog:dev",
    "@pnpm/types": "catalog:types",
    "actions-up": "catalog:dev",
    "clean-publish": "catalog:dev",
    "commitizen": "catalog:dev",
    "cz-conventional-changelog": "catalog:dev",
    "eslint-plugin-github-action": "catalog:lint",
    "eslint-plugin-no-only-tests": "catalog:lint",
    "eslint-plugin-perfectionist": "catalog:lint",
    "eslint-plugin-react-hooks": "catalog:lint",
    "eslint-plugin-unused-imports": "catalog:lint",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:lint",
    "@root/scripts": "workspace:*",
    "@root/shared": "workspace:*",
    "@root/tsconfig": "workspace:*",
    "turbo": "catalog:dev",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev",
    "yaml-eslint-parser": "catalog:lint"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "v12.0.0",
      "onFail": "download"
    },
    "runtime": {
      "name": "node",
      "version": "^24.0.0 || >=26.0.0",
      "onFail": "download"
    }
  }
}
