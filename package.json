{
  "name": "root",
  "private": true,
  "description": "PostCSS plugin that makes it easier to write responsive styles",
  "scripts": {
    "build": "turbo build",
    "dev": "turbo dev",
    "test": "turbo test",
    "clean": "pnpm --filter '*' --filter '.' exec rm -rf .turbo node_modules dist package",
    "test:project": "f() { vitest run --project=\"$1\"; }; f",
    "ci:version": "changeset version && pnpm ci",
    "actions:update": "actions-up",
    "hooks:update": "lefthook uninstall && lefthook install"
  },
  "keywords": [
    "postcss",
    "postcss-plugin"
  ],
  "author": "Vladislav Shkodin <smashercosmo@gmail.com>",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/smashercosmo/postcss-responsive-hints/issues"
  },
  "homepage": "https://github.com/smashercosmo/postcss-responsive-hints#readme",
  "peerDependencies": {
    "postcss": ">=8"
  },
  "devDependencies": {
    "@changesets/cli": "catalog:tools",
    "@changesets/types": "^6.1.0",
    "@commitlint/cli": "^21.2.1",
    "@commitlint/config-conventional": "^21.2.0",
    "@commitlint/cz-commitlint": "^21.2.0",
    "@commitlint/types": "^21.2.0",
    "@postcss-responsive-hints/tsconfig": "workspace:*",
    "@postcss-responsive-hints/vitest": "workspace:*",
    "@pshevche/act-test-runner": "catalog:tools",
    "@types/node": "catalog:types",
    "actions-up": "catalog:tools",
    "clean-publish": "catalog:tools",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lefthook": "^2.1.10",
    "oxfmt": "catalog:tools",
    "tsdown": "catalog:dev",
    "turbo": "catalog:tools",
    "typescript": "catalog:dev",
    "vitest": "catalog:dev"
  },
  "devEngines": {
    "packageManager": {
      "name": "pnpm",
      "version": "11.10.0",
      "onFail": "warn"
    },
    "runtime": {
      "name": "node",
      "version": ">=24.0.0"
    }
  },
  "packageManager": "pnpm@11.10.0",
  "engines": {
    "node": ">=24.0.0"
  }
}
