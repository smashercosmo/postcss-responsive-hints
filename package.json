{
  "name": "root",
  "version": "0.0.0",
  "private": true,
  "license": "MIT",
  "author": "Vladislav Shkodin <smashercosmo@gmail.com>",
  "type": "module",
  "scripts": {
    "build": "pnpm -r run build",
    "dev": "pnpm -r --parallel run dev",
    "test": "pnpm -r --if-present run test",
    "lint:ox": "oxlint",
    "lint:types": "pnpm -r --if-present run typecheck && tsc",
    "lint": "pnpm lint:ox && pnpm lint:types",
    "format": "oxfmt",
    "cleanup": "rm -rf node_modules && pnpm -r exec rm -rf node_modules dist",
    "update:deps": "pnpm up -r --latest --interactive"
  },
  "devDependencies": {
    "@smashercosmo/configs": "catalog:dev",
    "@types/node": "catalog:types",
    "eslint-plugin-regexp": "catalog:lint",
    "oxfmt": "catalog:dev",
    "oxlint": "catalog:lint",
    "oxlint-tsgolint": "catalog:lint",
    "typescript": "catalog:dev"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": "^26.0.0",
      "onFail": "download"
    }
  },
  "packageManager": "pnpm@12.21.0"
}
