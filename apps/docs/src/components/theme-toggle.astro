
{
  /**
   * One button that switches to the opposite of the theme on screen. Picking
   * the theme of the system again forgets the choice, so the site follows the
   * system again. The layout applies a stored choice before the first paint.
   *
   * Both states are in the markup and CSS shows the one for the theme on
   * screen, so the button is right even before, or without, the script.
   */
}
<button class="theme-toggle" type="button">
  <span class="theme-toggle__state theme-toggle__state--light">
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <circle cx="8" cy="8" r="3" />
      <path
        d="M8 1v2M8 13v2M1 8h2M13 8h2M3.05 3.05l1.4 1.4M11.55 11.55l1.4 1.4M3.05 12.95l1.4-1.4M11.55 4.45l1.4-1.4"
      />
    </svg>
    <span class="visually-hidden">Switch to the dark theme</span>
  </span>
  <span class="theme-toggle__state theme-toggle__state--dark">
    <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false">
      <path d="M13.5 9.5A5.5 5.5 0 1 1 6.5 2.5a4.5 4.5 0 0 0 7 7Z" />
    </svg>
    <span class="visually-hidden">Switch to the light theme</span>
  </span>
</button>

<script>
  import { THEME_KEY } from "#root/site.js";

  type Theme = "light" | "dark";

  const button = document.querySelector<HTMLButtonElement>(".theme-toggle");
  const prefersDark = matchMedia("(prefers-color-scheme: dark)");

  function systemTheme(): Theme {
    return prefersDark.matches ? "dark" : "light";
  }

  /** The theme on screen: the picked one, or else the system's. */
  function renderedTheme(): Theme {
    const { theme } = document.documentElement.dataset;
    return theme === "light" || theme === "dark" ? theme : systemTheme();
  }

  /** A picked theme, or `undefined` to follow the system. */
  function apply(theme: Theme | undefined) {
    if (theme === undefined) {
      delete document.documentElement.dataset["theme"];
    } else {
      document.documentElement.dataset["theme"] = theme;
    }
  }

  button?.addEventListener("click", () => {
    const next: Theme = renderedTheme() === "dark" ? "light" : "dark";
    /**
     * Back to the system's theme undoes the choice, instead of storing it,
     * which would keep that theme when the system changes. Only checked here:
     * a stored theme that the system later matches is kept.
     */
    const picked = next === systemTheme() ? undefined : next;
    apply(picked);
    try {
      if (picked === undefined) {
        localStorage.removeItem(THEME_KEY);
      } else {
        localStorage.setItem(THEME_KEY, picked);
      }
    } catch {
      // Storage is unavailable: the choice lasts until the page is reloaded
    }
  });

  // The theme was picked in another tab
  globalThis.addEventListener("storage", (event) => {
    if (event.key === THEME_KEY) {
      const theme = event.newValue;
      apply(theme === "light" || theme === "dark" ? theme : undefined);
    }
  });
</script>

<style>
  .theme-toggle {
    display: inline-grid;
    place-items: center;
    min-inline-size: 24px;
    min-block-size: 24px;
    padding: 0.25rem;
    border: 1px solid var(--control-border);
    background: var(--paper-raised);
    color: var(--ink);
    cursor: pointer;
  }

  .theme-toggle:hover {
    border-color: var(--accent);
  }

  .theme-toggle svg {
    display: block;
    width: 1rem;
    height: 1rem;
    fill: none;
    stroke: currentcolor;
    stroke-linecap: round;
    stroke-width: 1.5;
  }

  /*
   * The state for the theme on screen. display: none also takes the other one
   * out of the accessibility tree, so the name of the button is always right.
   */
  .theme-toggle__state--dark {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme-toggle__state--light {
    display: none;
  }

  :global(:root[data-theme="dark"]) .theme-toggle__state--dark {
    display: contents;
  }

  @media (prefers-color-scheme: dark) {
    :global(:root:not([data-theme="light"])) .theme-toggle__state--light {
      display: none;
    }

    :global(:root:not([data-theme="light"])) .theme-toggle__state--dark {
      display: contents;
    }
  }

  @media (max-width: 42rem) {
    .theme-toggle {
      margin-inline-start: auto;
    }
  }
</style>
