{
  "$schema": "https://turborepo.dev/schema.json",
  "tasks": {
    "build": {
      "dependsOn": ["^build"],
      "outputs": ["dist/**"],
    },
    "dev": {
      "dependsOn": ["^build"],
      "cache": false,
      "persistent": true,
    },
    "test": {
      "cache": false,
    },
    // https://turborepo.dev/docs/guides/tools/typescript#linting-your-codebase
    "noop": {
      "dependsOn": ["^noop"],
    },
    "typecheck": {
      "dependsOn": ["noop"],
    },
  },
}
